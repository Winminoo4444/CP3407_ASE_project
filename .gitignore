# Godot-specific ignores

# Imported assets (re-generated automatically)
.import/
.godot/

# Exported builds
export.cfg
export_presets.cfg

# Mono / C# (if using Godot with .NET)
.mono/
data_*/
*.csproj
*.sln

# Build outputs
bin/
obj/

# Temporary files
*.tmp
*.temp
*.log

# OS-specific files
.DS_Store
Thumbs.db

# IDE/editor files
.vscode/
.idea/
*.swp
*.swo

# Godot editor settings (optional - personal preference)
.editor_settings-*.tres

# Crash logs
crashlog.txt

# Backup files
*~
